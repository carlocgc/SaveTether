<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core library: no console, no UI, no process exit. Must stay trimmable and AOT-safe. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Needed by the source-generated P/Invoke in FileSystem/WindowsReparse.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SaveTether.Tests" />
  </ItemGroup>

  <!-- The shipped app definitions, built into the binary (design 5.2, "Where definitions come from"). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\definitions\*.jsonc" LogicalName="definitions/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\definitions\imported\ludusavi.jsonl.gz" LogicalName="definitions/imported/ludusavi.jsonl.gz" />
  </ItemGroup>

</Project>
