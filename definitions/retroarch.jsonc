// RetroArch (multi-system emulator front end). Shipped with SaveTether; replaces the Ludusavi entry, which lists only saves and
// states. The folders are RetroArch's defaults (saves, states, system, thumbnails and screenshots under its config folder, or
// beside retroarch.exe on Windows). Cheats are left out: RetroArch downloads its cheat files itself.
// EmuDeck (read in its scripts and on the owner's Steam Deck, 2026-11-24) keeps the Flatpak's folders: it points RetroArch's
// save and state settings at Emulation/saves/retroarch/{saves,states}, which are links it makes to the Flatpak's own folders.
// It points the system folder at Emulation/bios, which all its emulators share, so the emudeck install has no system role.
// Design 5.2 explains the format.
{
  "schema": 1,
  "id": "retroarch",
  "name": "RetroArch",
  "kind": "emulator",
  "tier": "verified",
  "installs": [
    {
      "id": "win-install",
      "os": "windows",
      "detect": { "file": "{install_dir}/retroarch.cfg" },
      "base": "{install_dir}"
    },
    {
      "id": "linux-flatpak",
      "os": "linux",
      "detect": { "file": "{flatpak:org.libretro.RetroArch}/config/retroarch/retroarch.cfg" },
      "base": "{flatpak:org.libretro.RetroArch}/config/retroarch"
    },
    {
      "id": "emudeck",
      "os": "linux",
      "detect": { "dir": "{emudeck}/saves/retroarch" },
      "base": "{flatpak:org.libretro.RetroArch}/config/retroarch"
    },
    {
      "id": "linux-native",
      "os": "linux",
      "detect": { "file": "{xdg_config}/retroarch/retroarch.cfg" },
      "base": "{xdg_config}/retroarch"
    }
  ],
  "roles": [
    {
      "id": "saves",
      "class": "save",
      "default": true,
      "path": "saves",
      "target": "saves",
      "notes": "In-game saves (.srm and others), for every core."
    },
    {
      "id": "states",
      "class": "state",
      "default": false,
      "path": "states",
      "target": "states",
      "notes": "Save states: a newer core may not load an older one."
    },
    {
      "id": "system",
      "class": "system",
      "default": false,
      "path": { "win-install": "system", "linux-flatpak": "system", "linux-native": "system" },
      "target": "system",
      "notes": "BIOS and system files the cores need. Not offered with EmuDeck, whose BIOS folder is shared by all its emulators."
    },
    {
      "id": "thumbnails",
      "class": "media",
      "default": false,
      "path": "thumbnails",
      "target": "thumbnails",
      "notes": "Box art, title screens and snaps for the playlists: can be large."
    },
    {
      "id": "screenshots",
      "class": "media",
      "default": false,
      "path": "screenshots",
      "target": "screenshots",
      "notes": "Screenshots."
    }
  ],
  "quirks": [
    "cores, playlists, config (core overrides), cheats and retroarch.cfg stay on each device: cores are built for each system, playlists hold full paths, and RetroArch downloads cheats itself.",
    "Settings > Directory can move any of these folders; Add app follows the default location only. Check them before adding: a folder moved by hand is not the one linked.",
    "With EmuDeck, choose the EmuDeck install. Its save and state folders are links to the Flatpak's, which are the ones linked; its BIOS folder (Emulation/bios) is shared by all its emulators, so it is left out.",
    "On Windows set the install folder to the one holding retroarch.exe, which is also the Steam copy's folder.",
    "Process name for the running check: retroarch.exe on Windows, retroarch on Linux."
  ]
}
