// DuckStation (PlayStation 1 emulator). Shipped with SaveTether. The Windows and native Linux folders are
// DuckStation's defaults; the Flatpak and EmuDeck installs were found on the owner's Steam Deck. `app add --dry-run` was run on the Deck
// (2026-11-22) for emudeck, linux-native and linux-flatpak; only the Windows installs are untried. Design 5.2 explains the format.
{
  "schema": 1,
  "id": "duckstation",
  "name": "DuckStation",
  "kind": "emulator",
  "tier": "verified",
  "tested_on": ["Steam Deck, EmuDeck (dry run found the card)"],
  "installs": [
    {
      "id": "win-portable",
      "os": "windows",
      "detect": { "dir": "{install_dir}/memcards" },
      "base": "{install_dir}"
    },
    {
      "id": "win-documents",
      "os": "windows",
      "detect": { "dir": "{documents}/DuckStation/memcards" },
      "base": "{documents}/DuckStation"
    },
    {
      "id": "linux-flatpak",
      "os": "linux",
      "detect": { "dir": "{flatpak:org.duckstation.DuckStation}/data/duckstation/memcards" },
      "base": "{flatpak:org.duckstation.DuckStation}/data/duckstation"
    },
    {
      "id": "linux-native",
      "os": "linux",
      "detect": { "dir": "{xdg_data}/duckstation/memcards" },
      "base": "{xdg_data}/duckstation"
    },
    {
      "id": "emudeck",
      "os": "linux",
      "detect": { "dir": "{emudeck}/saves/duckstation/saves" },
      "base": "{emudeck}/saves/duckstation"
    }
  ],
  "roles": [
    {
      "id": "memcards",
      "class": "save",
      "default": true,
      "path": { "win-portable": "memcards", "win-documents": "memcards", "linux-flatpak": "memcards", "linux-native": "memcards", "emudeck": "saves" },
      "target": "memcards",
      "notes": "Memory cards: .mcd files, one per game by default, plus shared_card_1.mcd."
    },
    {
      "id": "savestates",
      "class": "state",
      "default": false,
      "path": { "win-portable": "savestates", "win-documents": "savestates", "linux-flatpak": "savestates", "linux-native": "savestates", "emudeck": "states" },
      "target": "savestates",
      "notes": "Save states: large, and a newer DuckStation may not load an older one."
    },
    {
      "id": "bios",
      "class": "system",
      "default": false,
      "path": { "win-portable": "bios", "win-documents": "bios", "linux-flatpak": "bios", "linux-native": "bios" },
      "target": "bios",
      "notes": "PlayStation BIOS images. Not for EmuDeck: it keeps them in the shared Emulation/bios folder."
    },
    {
      "id": "screenshots",
      "class": "media",
      "default": false,
      "path": { "win-portable": "screenshots", "win-documents": "screenshots", "linux-flatpak": "screenshots", "linux-native": "screenshots" },
      "target": "screenshots",
      "notes": "Screenshots. Not for EmuDeck, whose app data folder is not under its saves folder."
    },
    {
      "id": "videos",
      "class": "media",
      "default": false,
      "path": { "win-portable": "videos", "win-documents": "videos", "linux-flatpak": "videos", "linux-native": "videos" },
      "target": "videos",
      "notes": "Recorded videos. Not for EmuDeck, whose app data folder is not under its saves folder."
    },
    {
      "id": "textures",
      "class": "mod",
      "default": false,
      "path": { "win-portable": "textures", "win-documents": "textures", "linux-flatpak": "textures", "linux-native": "textures" },
      "target": "textures",
      "notes": "Texture replacements. Not for EmuDeck, whose app data folder is not under its saves folder."
    }
  ],
  "quirks": [
    "EmuDeck keeps the cards in Emulation/saves/duckstation/saves and the states in .../states; the folder names differ from the other installs.",
    "Settings > Folders can move either folder (an existing setup may point both at a synced folder already); Add app follows the default location only.",
    "Process name for the running check: duckstation-qt-x64-ReleaseLTCG.exe on Windows, duckstation-qt or the AppImage on Linux."
  ]
}
