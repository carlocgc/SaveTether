// Cemu (Wii U emulator). Shipped with SaveTether: win-portable and linux-native were used on both of the
// owner's devices in the M7 trial, 2026-11-12; win-documents and linux-flatpak come from the Ludusavi manifest
// and are not yet tested on hardware. Design 5.2 explains the format.
{
  "schema": 1,
  "id": "cemu",
  "name": "Cemu",
  "kind": "emulator",
  "installs": [
    {
      "id": "win-portable",
      "os": "windows",
      "detect": { "dir": "{install_dir}/mlc01" },
      "base": "{install_dir}/mlc01"
    },
    {
      "id": "win-documents",
      "os": "windows",
      "detect": { "dir": "{documents}/mlc01" },
      "base": "{documents}/mlc01"
    },
    {
      "id": "linux-flatpak",
      "os": "linux",
      "detect": { "dir": "{flatpak:info.cemu.Cemu}/data/Cemu/mlc01" },
      "base": "{flatpak:info.cemu.Cemu}/data/Cemu/mlc01"
    },
    {
      "id": "linux-native",
      "os": "linux",
      "detect": { "dir": "{xdg_data}/Cemu/mlc01" },
      "base": "{xdg_data}/Cemu/mlc01"
    }
  ],
  "roles": [
    {
      "id": "save",
      "class": "save",
      "default": true,
      "path": "usr/save",
      "target": "save",
      // Games sit two levels down: usr/save/00050000/<title id>.
      "entry_depth": 2
    }
  ],
  "quirks": [
    "Link usr/save, not mlc01: game updates and DLC install into mlc01/usr/title and can run to many gigabytes.",
    "mlc_path in settings.xml must be empty, so Cemu uses the mlc01 folder beside it.",
    "The older default on Windows is the mlc01 folder in Documents (win-documents). A portable copy may sit beside it; when both are found, Add app asks which to share."
  ]
}
