// Dolphin (GameCube and Wii emulator). Shipped with SaveTether; replaces the Ludusavi entry, which shares the whole user folder.
// The folders come from Dolphin's source (UICommon.cpp SetUserDirectory, CommonPaths.h), read 2026-11-22; the Flatpak folder was
// read on the owner's Steam Deck, where EmuDeck links Emulation/saves/dolphin to it. Not yet tried with `app add`. Design 5.2
// explains the format.
{
  "schema": 1,
  "id": "dolphin",
  "name": "Dolphin",
  "kind": "emulator",
  "tier": "verified",
  "installs": [
    {
      "id": "win-portable",
      "os": "windows",
      "detect": { "file": "{install_dir}/portable.txt" },
      "base": "{install_dir}/User"
    },
    {
      "id": "win-documents",
      "os": "windows",
      "detect": { "dir": "{documents}/Dolphin Emulator" },
      "base": "{documents}/Dolphin Emulator"
    },
    {
      "id": "win-appdata",
      "os": "windows",
      "detect": { "dir": "{appdata}/Dolphin Emulator" },
      "base": "{appdata}/Dolphin Emulator"
    },
    {
      "id": "linux-flatpak",
      "os": "linux",
      "detect": { "dir": "{flatpak:org.DolphinEmu.dolphin-emu}/data/dolphin-emu" },
      "base": "{flatpak:org.DolphinEmu.dolphin-emu}/data/dolphin-emu"
    },
    {
      "id": "linux-native",
      "os": "linux",
      "detect": { "dir": "{xdg_data}/dolphin-emu" },
      "base": "{xdg_data}/dolphin-emu"
    },
    {
      "id": "linux-legacy",
      "os": "linux",
      "detect": { "dir": "{home}/.dolphin-emu" },
      "base": "{home}/.dolphin-emu"
    }
  ],
  "roles": [
    {
      "id": "gc",
      "class": "save",
      "default": true,
      "path": "GC",
      "target": "GC",
      "notes": "GameCube memory cards (region folders of saves, or .raw card images) and the IPL."
    },
    {
      "id": "wii",
      "class": "save",
      "default": true,
      "path": "Wii",
      "target": "Wii",
      "notes": "The emulated Wii NAND: game saves under title/, and also the system menu, Miis and installed WiiWare."
    },
    {
      "id": "states",
      "class": "state",
      "default": false,
      "path": "StateSaves",
      "target": "StateSaves",
      "notes": "Save states: large, and a newer Dolphin may not load an older one."
    },
    {
      "id": "load",
      "class": "mod",
      "default": false,
      "path": "Load",
      "target": "Load",
      "notes": "Custom textures, graphics mods, Riivolution patches and dynamic input textures."
    },
    {
      "id": "resourcepacks",
      "class": "mod",
      "default": false,
      "path": "ResourcePacks",
      "target": "ResourcePacks",
      "notes": "Texture resource packs."
    },
    {
      "id": "screenshots",
      "class": "media",
      "default": false,
      "path": "ScreenShots",
      "target": "ScreenShots",
      "notes": "Screenshots."
    }
  ],
  "quirks": [
    "Config, Cache and Dump stay on each device: they hold graphics, controller and path settings.",
    "Dolphin picks its folder in this order: portable.txt beside Dolphin.exe, then Documents/Dolphin Emulator if it exists, then AppData/Roaming/Dolphin Emulator. On Linux: ~/.dolphin-emu if it exists, else ~/.local/share/dolphin-emu.",
    "EmuDeck keeps Dolphin's own Flatpak folder and only links Emulation/saves/dolphin to it, so use the Flatpak install there.",
    "Process name for the running check: Dolphin.exe on Windows, dolphin-emu on Linux."
  ]
}
