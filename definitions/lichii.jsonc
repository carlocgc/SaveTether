// Lichii (Nintendo Switch and Switch 2 emulator; experimental, built from Eglantine and Eden). Shipped with SaveTether. It keeps
// Eden's folder layout under its own name: its source (src/common/fs/fs_paths.h, EDEN_DIR "lichii", PORTABLE_DIR "user", read
// 2026-11-22) and the owner's portable copy under LaunchBox, whose user folder holds nand, sdmc, load, keys and the rest. Not yet tried
// with `app add`. Design 5.2 explains the format.
{
  "schema": 1,
  "id": "lichii",
  "name": "Lichii",
  "kind": "emulator",
  "tier": "verified",
  "installs": [
    {
      "id": "win-portable",
      "os": "windows",
      "detect": { "dir": "{install_dir}/user/nand" },
      "base": "{install_dir}/user"
    },
    {
      "id": "win-appdata",
      "os": "windows",
      "detect": { "dir": "{appdata}/lichii/nand" },
      "base": "{appdata}/lichii"
    },
    {
      "id": "linux-native",
      "os": "linux",
      "detect": { "dir": "{xdg_data}/lichii/nand" },
      "base": "{xdg_data}/lichii"
    }
  ],
  "roles": [
    {
      "id": "saves",
      "class": "save",
      "default": true,
      "path": "nand/user/save",
      "target": "save",
      "entry_depth": 3,
      "ignore": ["cache"],
      "notes": "Game saves: 0000000000000000/<profile ID>/<title ID>. A game finds its save only under the same profile ID on every device. The cache folder here is the emulator's own and need not sync."
    },
    {
      "id": "nand-system",
      "class": "system",
      "default": true,
      "path": "nand/system",
      "target": "system",
      "notes": "The emulated system memory: user profiles, system saves and the installed firmware (a few hundred MiB). On with saves: a game finds its save only under the same profile ID, so every device needs the same profiles."
    },
    {
      "id": "play_time",
      "class": "save",
      "default": false,
      "path": { "win-portable": "play_time", "win-appdata": "play_time", "linux-native": "play_time" },
      "target": "play_time",
    },
    {
      "id": "load",
      "class": "mod",
      "default": false,
      "path": "load",
      "target": "load",
      "notes": "Mods and cheats: a folder per title ID."
    },
    {
      "id": "sdmc",
      "class": "mod",
      "default": false,
      "path": "sdmc",
      "target": "sdmc",
      "notes": "The emulated SD card: mostly mods laid out for a console (atmosphere/contents). Games, updates and DLC installed to the SD card instead of the NAND land in Nintendo/Contents here, and would sync too."
    },
    {
      "id": "screenshots",
      "class": "media",
      "default": false,
      "path": "screenshots",
      "target": "screenshots",
      "notes": "Screenshots."
    },
    {
      "id": "keys",
      "class": "system",
      "default": false,
      "path": { "win-portable": "keys", "win-appdata": "keys", "linux-native": "keys" },
      "target": "keys",
    }
  ],
  "quirks": [
    "The config folder (or ~/.config/lichii), shader and cache stay on each device. Installed games, updates and DLC (nand/user/Contents) are not shared.",
    "Settings > Filesystem can move nand, sdmc, load and screenshots; Add app follows the default location only.",
    "Lichii is experimental and changes often; if a new build moves its folders, this definition may need updating.",
    "Process name for the running check: lichii.exe on Windows, lichii or the AppImage on Linux."
  ]
}
